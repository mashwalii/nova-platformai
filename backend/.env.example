# =============================================================================
# NOVA AI backend — environment variables TEMPLATE
# =============================================================================
# 1. Copy this file to `backend/.env`      (cp .env.example .env)
# 2. Change values in YOUR copy only.
# 3. NEVER commit `backend/.env` — it is blocked by .gitignore.
#
# Every setting has a safe default for local development, so the backend runs
# even if you change nothing. Blank values mean "not set".
# =============================================================================

# --- Application -------------------------------------------------------------
# development | test | staging | production
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000

# --- Logging -----------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# console (readable) | json (for servers). Blank = console in development, json elsewhere.
LOG_FORMAT=

# --- Browser access (CORS) ---------------------------------------------------
# Comma-separated list of website addresses allowed to call the API.
# Blank = localhost dev ports (8080, 5173) in development; NOTHING in staging/production.
# Example: https://nova-platformai.lovable.app,https://www.example.com
CORS_ALLOW_ORIGINS=
# Optional regular expression for origins (e.g. preview deployments). Use with care.
CORS_ALLOW_ORIGIN_REGEX=

# Interactive API docs at /docs. Blank = on, except in production.
DOCS_ENABLED=
# Largest accepted request body, in bytes (default 1 MB).
MAX_REQUEST_BODY_BYTES=1048576

# --- Database (PostgreSQL / Supabase) ----------------------------------------
# SECRET. Optional in development; REQUIRED in staging/production.
# Supabase: Project Settings -> Database -> Connection string -> URI.
# Examples:
#   postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres?sslmode=require
#   postgresql://nova:nova@localhost:5432/nova          (local PostgreSQL)
DATABASE_URL=

# SECRET. Optional separate (more privileged) connection used only for migrations.
# Must be a direct or session connection (NOT the transaction pooler on port 6543).
DATABASE_MIGRATION_URL=

# Set to true when DATABASE_URL uses a transaction-mode pooler (Supabase port 6543).
DATABASE_USE_PGBOUNCER=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_CONNECT_TIMEOUT_SECONDS=5
# Queries running longer than this are cancelled (0 = no limit).
DATABASE_STATEMENT_TIMEOUT_MS=30000
# Print every SQL statement to the log (development debugging only).
DATABASE_ECHO=false

# --- Tests only --------------------------------------------------------------
# A THROWAWAY database for the integration tests. Its name must contain "test";
# the tests delete and recreate the `app` schema in it.
# TEST_DATABASE_URL=postgresql://nova:nova@localhost:5432/nova_test
