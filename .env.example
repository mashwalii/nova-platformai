# =============================================================================
# NOVA AI — environment variables TEMPLATE
# =============================================================================
#
# This file lists variable NAMES only. It is safe to commit.
#
# How to use:
#   1. Copy this file to `.env` (or `.env.local`) in the same folder.
#   2. Fill in real values in your copy.
#   3. NEVER commit your `.env` file — it is blocked by .gitignore.
#
# ⚠️  SECURITY RULE — READ THIS:
#   Any variable whose name starts with `VITE_` is built into the website's
#   JavaScript and can be read by ANYONE who visits the site.
#   Only put PUBLIC, non-secret values in `VITE_` variables.
#   Secret keys (AI API keys, database passwords, service-role keys, email
#   API keys) must ONLY ever go in the backend's environment — never here
#   with a `VITE_` prefix.
#
# CURRENT STATUS:
#   The frontend currently needs NO environment variables. It runs entirely
#   on built-in sample data. Everything below is commented out and documents
#   variables planned in ARCHITECTURE.md / IMPLEMENTATION_PLAN.md.
# =============================================================================


# -----------------------------------------------------------------------------
# Frontend (public values only) — planned for Phase 12 / 13
# -----------------------------------------------------------------------------

# Base URL of the NOVA backend API (e.g. http://localhost:8000 when developing)
# VITE_API_URL=

# `true` = use the built-in sample data (current behaviour), `false` = use the API
# VITE_USE_MOCK_DATA=true

# Supabase project URL and PUBLIC "anon"/publishable key (used for login only).
# These are designed to be public. NEVER put the service-role/secret key here.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# Error monitoring (public DSN)
# VITE_SENTRY_DSN=


# -----------------------------------------------------------------------------
# Backend secrets — planned for Phase 2+
# These will live in `backend/.env` (also git-ignored) and in the hosting
# provider's secret settings. Listed here for reference only.
# -----------------------------------------------------------------------------

# DATABASE_URL=
# SUPABASE_JWT_ISSUER=
# ANTHROPIC_API_KEY=
# EMBEDDINGS_API_KEY=
# EMAIL_API_KEY=
# SENTRY_DSN=
# AI_DAILY_BUDGET_USD=
